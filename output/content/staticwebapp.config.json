{
	
	"routes": [
    { "route": "/solutions",       "redirect": "/capability-led-solutions",     "statusCode": 301 },
    { "route": "/solutions/*",     "redirect": "/capability-led-solutions",     "statusCode": 301 },

    { "route": "/fractional-cto-ai",       "redirect": "/capability-led-solutions/fractional-cto-ai", "statusCode": 301 },
    { "route": "/fractional-cto-ai/*",     "redirect": "/capability-led-solutions/fractional-cto-ai", "statusCode": 301 },

    { "route": "/consulting",   "redirect": "/capability-led-solutions",  "statusCode": 301 },
    { "route": "/consulting/*", "redirect": "/capability-led-solutions",  "statusCode": 301 }
  ],
  "responseOverrides": {
